{
  "$description": "JVL CRM design tokens — 'Hearth' refresh (2026-11). Source: the Hearth CRM design canvas (Dashboard, Users list, User details artboards) + its brand colour/typography references. Values marked derived:true are not drawn in the template and were derived to sit in the same warm family. Contrast ratios are WCAG 2.x against the stated surface. Implemented in src/index.css; this file is the reviewable source of truth.",
  "$schema": "https://design-tokens.github.io/community-group/format/",

  "primitive": {
    "gray": {
      "000": { "$value": "#FFFFFF" },
      "050": { "$value": "#FAF9F5", "$description": "Ivory" },
      "100": { "$value": "#F5F4ED" },
      "150": { "$value": "#F0EEE6" },
      "200": { "$value": "#E8E6DC" },
      "250": { "$value": "#DEDCD1" },
      "300": { "$value": "#D1CFC5" },
      "350": { "$value": "#C2C0B6" },
      "400": { "$value": "#B0AEA5" },
      "450": { "$value": "#9C9A92" },
      "500": { "$value": "#87867F" },
      "550": { "$value": "#73726C" },
      "600": { "$value": "#5E5D59" },
      "650": { "$value": "#4D4C48" },
      "700": { "$value": "#3D3D3A" },
      "750": { "$value": "#30302E" },
      "800": { "$value": "#262624" },
      "900": { "$value": "#1A1918" },
      "950": { "$value": "#141413", "$description": "Slate" }
    },
    "brand": {
      "clay": { "$value": "#D97757" },
      "clay-700": { "$value": "#A9583E" },
      "clay-800": { "$value": "#7F3F27" },
      "oat": { "$value": "#E3DACC" },
      "coral": { "$value": "#EBCECE" },
      "heather": { "$value": "#CBCADB" },
      "cactus": { "$value": "#BCD1CA" },
      "blue": { "$value": "#2A78D6" },
      "fig": { "$value": "#C46686" },
      "green-500": { "$value": "#558A42" },
      "violet-500": { "$value": "#6B4D9E" },
      "red-500": { "$value": "#B83A3A", "derived": true }
    }
  },

  "color": {
    "surface": {
      "background": { "$value": "{primitive.gray.050}", "$description": "page canvas; row hover inside cards" },
      "card": { "$value": "#FFFFFF", "$description": "panels, KPI tiles, tables, inputs" },
      "popover": { "$value": "#FFFFFF", "derived": true },
      "sidebar": { "$value": "{primitive.gray.100}" },
      "sunken": { "$value": "{primitive.gray.100}", "$description": "note cards, activity discs, disabled fields" },
      "muted": { "$value": "{primitive.gray.150}", "$description": "neutral pill, count chip, tag chip, progress track, skeleton, button hover" },
      "overlay": { "$value": "rgba(20,20,19,0.40)", "derived": true }
    },
    "text": {
      "foreground": { "$value": "{primitive.gray.950}", "contrast": { "white": 18.43, "ivory": 17.5 } },
      "secondary": { "$value": "{primitive.gray.700}", "contrast": { "white": 10.9, "sidebar": 9.88 } },
      "muted": { "$value": "{primitive.gray.600}", "contrast": { "white": 6.59, "ivory": 6.26, "sidebar": 5.98, "muted": 5.67 } },
      "tertiary": { "$value": "{primitive.gray.550}", "$description": "placeholder, axis ticks, idle icons — ONLY on white/ivory", "contrast": { "white": 4.82, "ivory": 4.58, "sidebar": 4.38 } },
      "disabled": { "$value": "{primitive.gray.450}", "$description": "exempt from contrast" },
      "link": { "$value": "{primitive.brand.clay-700}", "contrast": { "white": 5.06, "ivory": 4.8 } },
      "link-hover": { "$value": "{primitive.brand.clay-800}", "contrast": { "white": 7.95 } }
    },
    "border": {
      "default": { "$value": "rgba(31,30,29,0.15)", "$description": "cards, sidebar edge, header-row rule" },
      "subtle": { "$value": "rgba(31,30,29,0.10)", "$description": "row dividers, chart grid, menu separators" },
      "strong": { "$value": "rgba(31,30,29,0.30)", "$description": "outline buttons, pagination, chart baseline, dashed add-tag" },
      "input": { "$value": "{primitive.gray.500}", "$description": "text fields, select trigger, checkbox/radio, switch-off — deviates from template rgba(.3) (1.90:1) to meet WCAG 1.4.11", "contrast": { "white": 3.65, "ivory": 3.47 } },
      "ring": { "$value": "{primitive.brand.blue}", "$description": "2px solid outline, offset 2", "contrast": { "white": 4.42, "ivory": 4.19, "sidebar": 4.0 } }
    },
    "action": {
      "primary": { "$value": "{primitive.gray.950}" },
      "primary-foreground": { "$value": "{primitive.gray.050}", "contrast": { "primary": 17.5 } },
      "primary-hover": { "$value": "{primitive.gray.750}" },
      "secondary-hover": { "$value": "{primitive.gray.150}" },
      "destructive": { "$value": "{primitive.brand.red-500}", "derived": true, "$description": "outline hue; solid fill only on the confirm button of a delete dialog (ivory text 5.38)" },
      "destructive-ink": { "$value": "#973232", "derived": true, "contrast": { "white": 7.45 } }
    },
    "brand": {
      "brand": { "$value": "{primitive.brand.clay}", "$description": "single accent: logo mark, chart-1, progress fill. Never as text on white (3.12). Swappable: #2A78D6 / #788C5D / #C46686 were the template's alternatives" },
      "brand-strong": { "$value": "{primitive.brand.clay-700}", "$description": "clay as text, or as a fill under ivory text (4.80)" }
    },
    "selection": { "$value": "{primitive.gray.150}", "$description": "::selection, checked menu/select items" },
    "highlight": { "$value": "#F7E7DE", "$description": "<mark> search-match spans" },
    "status": {
      "neutral": { "bg": { "$value": "#F0EEE6" }, "fg": { "$value": "#5E5D59" }, "dot": { "$value": "#9C9A92" }, "contrast": 5.67 },
      "info": { "bg": { "$value": "#E2ECF6" }, "fg": { "$value": "#245E99" }, "dot": { "$value": "#2A78D6" }, "contrast": 5.6 },
      "success": { "bg": { "$value": "#E6EEDF" }, "fg": { "$value": "#3D6630" }, "dot": { "$value": "#558A42" }, "contrast": 5.62 },
      "warning": { "bg": { "$value": "#F7E7DE" }, "fg": { "$value": "#9A4A2E" }, "dot": { "$value": "#D97757" }, "contrast": 5.14 },
      "error": { "bg": { "$value": "#F4E1E1" }, "fg": { "$value": "#973232" }, "dot": { "$value": "#B83A3A" }, "contrast": 5.93, "derived": true },
      "note": { "bg": { "$value": "#EAE6F1" }, "fg": { "$value": "#5A4282" }, "dot": { "$value": "#6B4D9E" }, "contrast": 6.74, "derived": true },
      "chip": { "bg": { "$value": "#F0EEE6" }, "fg": { "$value": "#3D3D3A" }, "$description": "categorical label, no status, no dot", "contrast": 9.38 }
    },
    "chart": {
      "1": { "$value": "#D97757", "$description": "brand (accent first)" },
      "2": { "$value": "#2A78D6" },
      "3": { "$value": "#558A42" },
      "4": { "$value": "#C46686" },
      "5": { "$value": "#6B4D9E" },
      "$description": "CVD-validated (deuteranopia adjacent ΔE ≥ 8.2), every series ≥ 3:1 on white. Status encodings (ending buckets) use status dots, not chart colours.",
      "grid": { "$value": "{color.border.subtle}" },
      "baseline": { "$value": "{color.border.strong}" },
      "tick": { "$value": "{color.text.tertiary}" },
      "tooltip-bg": { "$value": "#141413" },
      "tooltip-fg": { "$value": "#FAF9F5" },
      "tooltip-label": { "$value": "#C2C0B6" }
    },
    "tag": {
      "$description": "Finder-style tag dots (user data, no status meaning). Shades chosen to reach 3:1 on white.",
      "red": { "$value": "#B83A3A" },
      "orange": { "$value": "#D97757" },
      "yellow": { "$value": "#AE9229", "derived": true },
      "green": { "$value": "#558A42" },
      "blue": { "$value": "#6898C8", "derived": true },
      "purple": { "$value": "#6B4D9E" },
      "gray": { "$value": "#87867F" }
    },
    "avatar": {
      "$description": "initials avatar fills, chosen by id % 4; Slate initials ≥ 11:1",
      "1": { "$value": "#E3DACC" },
      "2": { "$value": "#EBCECE" },
      "3": { "$value": "#CBCADB" },
      "4": { "$value": "#BCD1CA" }
    },
    "sidebar": {
      "foreground": { "$value": "#3D3D3A" },
      "active": { "$value": "rgba(115,114,108,0.14)" },
      "hover": { "$value": "rgba(115,114,108,0.10)" },
      "group-label": { "$value": "#5E5D59", "$description": "template #73726C fails on the sidebar (4.38)" }
    }
  },

  "font": {
    "sans": { "$value": "'Public Sans Variable', system-ui, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "$description": "@fontsource-variable/public-sans (OFL). Real 500 on every OS; tnum." },
    "serif": { "$value": "'Source Serif 4 Variable', Georgia, 'Times New Roman', Times, serif", "$description": "@fontsource-variable/source-serif-4 (OFL), opsz axis, lining tabular figures. Substitutes the template's proprietary serif." },
    "mono": { "$value": "'Geist Mono Variable', 'SF Mono', Monaco, 'Courier New', monospace", "$description": "codes only: NIF, IBAN, acesso/CPE, Nº serviço" }
  },

  "type": {
    "$description": "letter-spacing 0 everywhere; base body 14/20 400.",
    "display":    { "family": "serif", "size": 34, "lineHeight": 40, "weight": 400, "utility": "type-display (alias type-page-title)", "use": "page <h1>; 28/34 below 640px" },
    "metric":     { "family": "serif", "size": 34, "lineHeight": 38, "weight": 400, "tnum": true, "utility": "type-metric", "use": "dashboard KPI values" },
    "title":      { "family": "serif", "size": 28, "lineHeight": 34, "weight": 400, "tnum": true, "utility": "type-title", "use": "detail <h1> (profile card), compact KPI values, login heading" },
    "figure":     { "family": "serif", "size": 24, "lineHeight": 30, "weight": 400, "tnum": true, "utility": "type-figure", "use": "headline figure in a panel header" },
    "heading":    { "family": "serif", "size": 22, "lineHeight": 28, "weight": 500, "utility": "type-heading", "use": "card/panel <h2>, wordmark" },
    "heading-sm": { "family": "serif", "size": 20, "lineHeight": 26, "weight": 500, "utility": "type-heading-sm", "use": "side-column card titles, dialog/sheet titles" },
    "lead":       { "family": "sans", "size": 15, "lineHeight": 22, "weight": 400, "utility": "type-lead", "use": "page subline under <h1> (muted)" },
    "section":    { "family": "sans", "size": 14, "lineHeight": 20, "weight": 500, "utility": "type-section", "use": "small sans titles inside primitives (calendar caption, drop zone, empty state)" },
    "body":       { "family": "sans", "size": 14, "lineHeight": 20, "weight": 400, "utility": "type-body", "use": "default text, cells, dd" },
    "nav":        { "family": "sans", "size": 14, "lineHeight": 20, "weight": 400, "activeWeight": 500, "utility": "type-nav", "use": "sidebar, tabs, breadcrumb" },
    "control":    { "family": "sans", "size": 14, "lineHeight": 20, "weight": 500, "utility": "type-control", "use": "buttons, select triggers" },
    "dense":      { "family": "sans", "size": 13, "lineHeight": 18, "weight": 400, "utility": "type-dense (alias type-meta)", "use": "row second line, dates, detail lines, tag chips, helper text" },
    "label":      { "family": "sans", "size": 13, "lineHeight": 18, "weight": 500, "utility": "type-label", "use": "form labels" },
    "caption":    { "family": "sans", "size": 12, "lineHeight": 16, "weight": 400, "utility": "type-caption", "use": "dt terms, count chips, meta, tooltips, chart ticks, sidebar group label" },
    "eyebrow":    { "family": "sans", "size": 12, "lineHeight": 16, "weight": 500, "uppercase": false, "utility": "type-eyebrow", "use": "table headers, pills" },
    "mono":       { "family": "mono", "size": 13, "lineHeight": 20, "weight": 400, "tnum": true, "utility": "type-mono", "use": "codes and ids only" },
    "kbd":        { "family": "mono", "size": 11, "lineHeight": 16, "weight": 500, "utility": "type-kbd" },
    "avatar": { "24": "10/600 sans", "32": "12/600 sans", "36": "12/600 sans", "40": "14/600 sans", "72": "26/400 serif" }
  },

  "space": {
    "$description": "4px grid with 2px half-steps for chips. Tailwind spacing unit = 4px.",
    "page-padding": { "desktop": "32 40 48", "tablet": "28 24 40", "mobile": "20 16 32" },
    "content-max-width": 1200,
    "page-gap": 24,
    "grid-gap": 16,
    "card-padding": 24,
    "kpi-padding": 20,
    "table-card-padding": "24 0 8",
    "table-edge-inset": 24,
    "cell-padding": 12,
    "panel-title-gap": 4,
    "panel-section-gap": 16,
    "kpi-label-value-gap": 6,
    "pill-padding": "3 10",
    "count-chip-padding": "2 8",
    "tag-chip-padding": "4 10",
    "sidebar": { "width": 232, "padding": "20 12", "section-gap": 24, "item-gap": 2, "item-padding": "0 12", "icon-gap": 12 }
  },

  "size": {
    "control": { "sm": 32, "md": 40, "lg": 44, "icon": 40, "icon-sm": 36, "icon-xs": 28, "$description": "md default; lg toolbars/search/login; sm dialogs, inline edit, in-table actions" },
    "tab": { "page": 44, "card": 48, "padding": "0 12", "underline": 2 },
    "nav-item": 40,
    "pagination-button": 36,
    "checkbox": 16,
    "avatar": { "xs": 24, "sm": 32, "md": 36, "tile": 40, "xl": 72, "mark": 28 },
    "icon": { "nav": 18, "control": 16, "small": 14, "pill": 12 },
    "icon-stroke": { "16-18": 1.75, "<=14": 2, "pill": 2.5 },
    "dot": { "status": 6, "tag": 8 },
    "bar": { "ranked": 10, "progress": 6 },
    "mobile-topbar": 56
  },

  "radius": {
    "xs": { "$value": "4px", "use": "bars, progress, checkbox, kbd" },
    "sm": { "$value": "8px", "use": "nav items, icon buttons, pagination, menu items, tooltip, logo mark" },
    "md": { "$value": "10px", "use": "buttons, inputs, selects, textarea, company tile" },
    "lg": { "$value": "12px", "use": "popovers, menus, toasts, note cards, user card" },
    "xl": { "$value": "16px", "use": "cards, dialogs" },
    "full": { "$value": "9999px", "use": "pills, chips, avatars, dots" }
  },

  "border-width": {
    "hairline": { "$value": "0.5px", "$description": "Tailwind --default-border-width; every `border` is a hairline" },
    "1": { "$value": "1px", "use": "chart axes" },
    "2": { "$value": "2px", "use": "active tab underline, focus outline" }
  },

  "shadow": {
    "1": { "$value": "0 1px 2px rgba(20,20,19,0.04), 0 4px 12px rgba(20,20,19,0.08)", "derived": true, "use": "menus, popovers, toasts" },
    "2": { "$value": "0 2px 6px rgba(20,20,19,0.06), 0 16px 40px rgba(20,20,19,0.14)", "derived": true, "use": "dialogs, sheet" },
    "$description": "cards, tables and the sidebar have no shadow — border only"
  },

  "focus": { "$value": "outline 2px solid {color.border.ring}, outline-offset 2px", "$description": "same recipe on every surface; no box-shadow rings, no /50 opacity" },

  "motion": {
    "duration": { "$value": "150ms" },
    "easing": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "$description": "colour/border transitions only; overlays fade + 4px slide; prefers-reduced-motion zeroes everything except spinners"
  },

  "chart": {
    "bar-radius": "4 4 0 0",
    "bar-max-width": 48,
    "line-stroke": 2,
    "area-opacity": 0.12,
    "tick-size": 12,
    "tooltip": { "radius": 8, "padding": "8 10", "size": 12, "offset": 14 }
  }
}
